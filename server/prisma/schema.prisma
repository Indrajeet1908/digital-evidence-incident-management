// ============================================
// Digital Evidence Platform — Prisma Schema
// ============================================
// This file defines the database tables and their relationships.
// Prisma uses this to:
//   1. Generate TypeScript types for type-safe queries
//   2. Create database migrations (versioned schema changes)
//   3. Provide auto-completion in your editor
//
// After changing this file, run:
//   npx prisma migrate dev --name describe_your_change
//   npx prisma generate
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Case Enums
// ──────────────────────────────────────────────

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseConfidentiality {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum CaseType {
  CYBERSECURITY_INCIDENT
  DIGITAL_FORENSICS
  DATA_BREACH
  MALWARE
  PHISHING
  INSIDER_THREAT
  UNAUTHORIZED_ACCESS
  OTHER
}

enum CaseCategory {
  EMAIL_SECURITY
  ENDPOINT_SECURITY
  NETWORK_SECURITY
  IDENTITY_ACCESS
  DATA_SECURITY
  MALWARE
  SOCIAL_ENGINEERING
  OTHER
}

enum CaseMemberRole {
  LEAD_INVESTIGATOR
  INVESTIGATOR
  ANALYST
  VIEWER
}

// ──────────────────────────────────────────────
// Incident Enums
// ──────────────────────────────────────────────

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentType {
  PHISHING
  MALWARE
  DATA_BREACH
  UNAUTHORIZED_ACCESS
  ACCOUNT_COMPROMISE
  INSIDER_THREAT
  NETWORK_ATTACK
  ENDPOINT_COMPROMISE
  SUSPICIOUS_ACTIVITY
  OTHER
}

enum IncidentCategory {
  EMAIL_SECURITY
  IDENTITY_ACCESS
  ENDPOINT_SECURITY
  NETWORK_SECURITY
  DATA_SECURITY
  APPLICATION_SECURITY
  CLOUD_SECURITY
  OTHER
}

enum IncidentSource {
  USER_REPORT
  SOC_ALERT
  SIEM
  EDR
  EMAIL
  NETWORK_MONITORING
  THREAT_INTELLIGENCE
  MANUAL_INVESTIGATION
  OTHER
}

// ──────────────────────────────────────────────
// Role
// ──────────────────────────────────────────────
// Defines the access level a user has in the system.
// Seeded with: ADMIN, INVESTIGATOR, ANALYST, VIEWER
// A Role can have many Users assigned to it.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // One role → many users
  users User[]

  @@map("roles")
}

// ──────────────────────────────────────────────
// User
// ──────────────────────────────────────────────
// Represents a platform user (investigator, analyst, admin, etc.).
// Passwords are NEVER stored in plaintext — only the hashed version.
// Users are deactivated (isActive = false) rather than deleted,
// to preserve audit trails and chain-of-custody records.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Many users → one role
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  // Case Relationships
  createdCases          Case[]                  @relation("CaseCreatedBy")
  leadCases             Case[]                  @relation("CaseLeadInvestigator")
  closedCases           Case[]                  @relation("CaseClosedBy")
  caseMemberships       CaseMember[]
  caseStatusChanges     CaseStatusHistory[]

  // Incident Relationships
  createdIncidents      Incident[]              @relation("IncidentCreatedBy")
  assignedIncidents     Incident[]              @relation("IncidentAssignedTo")
  incidentStatusChanges IncidentStatusHistory[]

  @@index([email])
  @@index([roleId])
  @@map("users")
}

// ──────────────────────────────────────────────
// Case
// ──────────────────────────────────────────────
// The central container for an investigation.
model Case {
  id                 String              @id @default(uuid()) @db.Uuid
  caseNumber         String              @unique @map("case_number") @db.VarChar(50)
  title              String              @db.VarChar(255)
  description        String?             @db.Text
  caseType           CaseType            @default(CYBERSECURITY_INCIDENT) @map("case_type")
  category           CaseCategory        @default(OTHER)
  severity           CaseSeverity        @default(MEDIUM)
  priority           CasePriority        @default(MEDIUM)
  confidentiality    CaseConfidentiality @default(INTERNAL)
  status             CaseStatus          @default(OPEN)

  // Timeline
  incidentDate       DateTime?           @map("incident_date")
  detectedAt         DateTime?           @map("detected_at")
  reportedAt         DateTime?           @map("reported_at")
  dueDate            DateTime?           @map("due_date")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  closedAt           DateTime?           @map("closed_at")

  // Ownership & Assignments
  createdById        String              @map("created_by_id") @db.Uuid
  createdBy          User                @relation("CaseCreatedBy", fields: [createdById], references: [id])
  leadInvestigatorId String?             @map("lead_investigator_id") @db.Uuid
  leadInvestigator   User?               @relation("CaseLeadInvestigator", fields: [leadInvestigatorId], references: [id])
  closedById         String?             @map("closed_by_id") @db.Uuid
  closedBy           User?               @relation("CaseClosedBy", fields: [closedById], references: [id])

  // Organization & Audit
  tags               String[]            @default([])
  closureReason      String?             @map("closure_reason") @db.Text

  // Sub-models
  members            CaseMember[]
  statusHistory      CaseStatusHistory[]
  incidents          Incident[]

  @@index([status])
  @@index([priority])
  @@index([severity])
  @@index([caseType])
  @@index([category])
  @@index([createdById])
  @@index([leadInvestigatorId])
  @@index([createdAt])
  @@map("cases")
}

// ──────────────────────────────────────────────
// CaseMember
// ──────────────────────────────────────────────
// Connects Case and User with an investigation-specific member role.
model CaseMember {
  id        String         @id @default(uuid()) @db.Uuid
  caseId    String         @map("case_id") @db.Uuid
  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CaseMemberRole @default(INVESTIGATOR)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([caseId, userId])
  @@index([caseId])
  @@index([userId])
  @@map("case_members")
}

// ──────────────────────────────────────────────
// CaseStatusHistory
// ──────────────────────────────────────────────
// Immutable audit record of case status transitions.
model CaseStatusHistory {
  id             String      @id @default(uuid()) @db.Uuid
  caseId         String      @map("case_id") @db.Uuid
  case           Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  previousStatus CaseStatus? @map("previous_status")
  newStatus      CaseStatus  @map("new_status")
  changedById    String      @map("changed_by_id") @db.Uuid
  changedBy      User        @relation(fields: [changedById], references: [id])
  reason         String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([caseId])
  @@index([changedById])
  @@index([createdAt])
  @@map("case_status_history")
}

// ──────────────────────────────────────────────
// Incident
// ──────────────────────────────────────────────
// Represents a specific security event associated with a Case.
model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  incidentNumber String           @unique @map("incident_number") @db.VarChar(50)
  caseId         String           @map("case_id") @db.Uuid
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title          String           @db.VarChar(255)
  description    String?          @db.Text
  incidentType   IncidentType     @default(OTHER) @map("incident_type")
  category       IncidentCategory @default(OTHER)
  severity       IncidentSeverity @default(MEDIUM)
  priority       IncidentPriority @default(MEDIUM)
  status         IncidentStatus   @default(OPEN)
  source         IncidentSource   @default(OTHER)

  // Timeline
  detectedAt     DateTime?        @map("detected_at")
  occurredAt     DateTime?        @map("occurred_at")
  reportedAt     DateTime?        @map("reported_at")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Ownership & Assignments
  createdById    String           @map("created_by_id") @db.Uuid
  createdBy      User             @relation("IncidentCreatedBy", fields: [createdById], references: [id])
  assignedToId   String?          @map("assigned_to_id") @db.Uuid
  assignedTo     User?            @relation("IncidentAssignedTo", fields: [assignedToId], references: [id])

  // Resolution Details
  resolution     String?          @db.Text

  // Sub-models
  statusHistory  IncidentStatusHistory[]

  @@index([caseId])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([incidentType])
  @@index([category])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("incidents")
}

// ──────────────────────────────────────────────
// IncidentStatusHistory
// ──────────────────────────────────────────────
// Immutable audit record of incident status transitions.
model IncidentStatusHistory {
  id             String          @id @default(uuid()) @db.Uuid
  incidentId     String          @map("incident_id") @db.Uuid
  incident       Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  previousStatus IncidentStatus? @map("previous_status")
  newStatus      IncidentStatus  @map("new_status")
  changedById    String          @map("changed_by_id") @db.Uuid
  changedBy      User            @relation(fields: [changedById], references: [id])
  reason         String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([incidentId])
  @@index([changedById])
  @@index([createdAt])
  @@map("incident_status_history")
}
