# ============================================
# Digital Evidence Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================

# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL via Docker)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=evidence_platform_db
DB_HOST=localhost
DB_PORT=5433
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5433/evidence_platform_db

# JWT (configured in Milestone 3)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=24h

# Evidence Storage & Limits (Milestone 7)
MAX_EVIDENCE_FILE_SIZE_MB=100
EVIDENCE_STORAGE_PATH=storage/evidence

# AI Services (will be configured in Phase 2)
# OPENAI_API_KEY=your-api-key-here

