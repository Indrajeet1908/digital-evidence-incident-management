# ============================================
# Digital Evidence Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================

# Server
NODE_ENV=development
PORT=5000

# Database (will be configured in Milestone 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/evidence_platform

# JWT (will be configured in Milestone 3)
# JWT_SECRET=replace-with-a-strong-random-secret
# JWT_EXPIRES_IN=24h

# AI Services (will be configured in Phase 2)
# OPENAI_API_KEY=your-api-key-here
