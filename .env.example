# ============================================
# Digital Evidence Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================

# Server Environment
# Options: development, test, production
NODE_ENV=development
PORT=5000

# CORS Whitelist (comma-separated origins)
# In production, specify exact domain(s) e.g., https://evidence.youragency.gov
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL via Docker)
# In production with docker-compose.production.yml, the DB_HOST is 'postgres' on port 5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=evidence_platform_db
DB_HOST=localhost
DB_PORT=5433
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5433/evidence_platform_db

# JWT Authentication
# In production, JWT_SECRET MUST be a cryptographically random string >= 32 characters
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=24h

# Evidence Storage & Limits (Milestone 7)
MAX_EVIDENCE_FILE_SIZE_MB=100
EVIDENCE_STORAGE_PATH=storage/evidence

# AI Services (Milestone 9: AI-Assisted Evidence Analysis)
# Provider options: gemini, openai, mock
AI_PROVIDER=gemini

# Google Gemini API Configuration (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (server-side only, if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# AI Preprocessing limits
MAX_AI_INPUT_CHARACTERS=50000
